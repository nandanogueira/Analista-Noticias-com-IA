# Copie este arquivo para ".env" e preencha as chaves.
# NUNCA coloque chaves reais neste arquivo: ele vai para o GitHub. As chaves ficam só no ".env".

# NewsAPI (obrigatória) — https://newsapi.org/register
NEWSAPI_KEY=

# IA principal: Groq — https://console.groq.com/keys
GROQ_API_KEY=
# IA reserva (usada se o Groq falhar ou atingir o limite): Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos (opcional; se vazio, usa openai/gpt-oss-120b no Groq e gemini-3-flash-preview no Gemini)
GROQ_MODEL=
GEMINI_MODEL=
